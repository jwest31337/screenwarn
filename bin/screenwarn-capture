#!/usr/bin/env bash

set -euo pipefail

#
# Config
#

CONFIG_FILE="$HOME/.config/screenwarn.env"

if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "ERROR: Missing config file: $CONFIG_FILE"
    exit 1
fi

# shellcheck disable=SC1090
source "$CONFIG_FILE"

#
# Input event line
#

EVENT_LINE="${1:-unknown event}"

#
# Runtime paths
#

STATE_DIR="$HOME/.local/state/screenwarn"
EVENT_ROOT="$HOME/.local/share/screenwarn/events"

mkdir -p "$STATE_DIR"
mkdir -p "$EVENT_ROOT"

HANDLER_LOG="$STATE_DIR/handler.log"

#
# Fallback defaults
#

CAMERA_DEVICE="${CAMERA_DEVICE:-/dev/video0}"

CAPTURE_SIZE="${CAPTURE_SIZE:-1280x720}"
CAPTURE_FPS="${CAPTURE_FPS:-10}"
CAPTURE_SECONDS="${CAPTURE_SECONDS:-2}"

STEALTH_DELAY="${STEALTH_DELAY:-0.7}"

ENABLE_NTFY="${ENABLE_NTFY:-false}"
NTFY_PRIORITY="${NTFY_PRIORITY:-urgent}"

ENABLE_EMAIL="${ENABLE_EMAIL:-false}"
EMAIL_ATTACH_MP4="${EMAIL_ATTACH_MP4:-false}"

RETENTION_DAYS="${RETENTION_DAYS:-30}"

#
# Logging helper
#

log() {
    local timestamp
    timestamp=$(date +"%Y-%m-%d %H:%M:%S")

    echo "[$timestamp] $*" >> "$HANDLER_LOG"
}

#
# Event directory setup
#

EVENT_ID=$(date +"%Y-%m-%d_%H-%M-%S")
EVENT_DIR="$EVENT_ROOT/$EVENT_ID"

mkdir -p "$EVENT_DIR"

#
# Update latest symlink
#

ln -sfn "$EVENT_DIR" "$HOME/.local/share/screenwarn/latest"

#
# Media paths
#

MP4_PATH="$EVENT_DIR/capture.mp4"
GIF_PATH="$EVENT_DIR/capture.gif"
PALETTE_PATH="$EVENT_DIR/palette.png"

#
# Startup logging
#

log "Creating event archive: $EVENT_ID"

#
# Save triggering journal line
#

echo "$EVENT_LINE" > "$EVENT_DIR/journal.txt"

#
# Collect nearby WiFi information
#

nmcli -t -f SSID,SIGNAL dev wifi \
    > "$EVENT_DIR/wifi.txt" \
    2>/dev/null || true

#
# Metadata file
#

cat > "$EVENT_DIR/metadata.env" <<EOF
EVENT_ID=$EVENT_ID
TIMESTAMP=$(date --iso-8601=seconds)
HOSTNAME=$(hostname)
USER=$USER
EOF

#
# Human-readable event report
#

cat > "$EVENT_DIR/event.log" <<EOF
Screenwarn Event Report
=======================

Event ID:
$EVENT_ID

Timestamp:
$(date)

Hostname:
$(hostname)

User:
$USER

Trigger:
KDE lockscreen authentication failure

Journal Event:
$EVENT_LINE
EOF

#
# Brief delay before webcam activation
#

log "Waiting briefly before webcam activation..."

sleep "$STEALTH_DELAY"

#
# Webcam capture
#

log "Starting webcam capture..."

if ffmpeg \
    -loglevel quiet \
    -f video4linux2 \
    -framerate "$CAPTURE_FPS" \
    -video_size "$CAPTURE_SIZE" \
    -i "$CAMERA_DEVICE" \
    -t "$CAPTURE_SECONDS" \
    -y "$MP4_PATH"
then
    log "Webcam capture complete: $MP4_PATH"

    #
    # GIF palette generation
    #

    log "Generating GIF palette..."

    if ffmpeg \
        -loglevel quiet \
        -i "$MP4_PATH" \
        -vf palettegen \
        -y "$PALETTE_PATH"
    then
        log "GIF palette generated"
    else
        log "ERROR: GIF palette generation failed"
    fi

    #
    # GIF preview generation
    #

    log "Generating GIF preview..."

    if ffmpeg \
        -loglevel quiet \
        -i "$MP4_PATH" \
        -i "$PALETTE_PATH" \
        -lavfi "fps=6,paletteuse" \
        -y "$GIF_PATH"
    then
        log "GIF preview created: $GIF_PATH"
    else
        log "ERROR: GIF generation failed"
    fi

    #
    # Cleanup temporary palette
    #

    rm -f "$PALETTE_PATH"

else
    log "ERROR: Webcam capture failed"
fi

#
# Event archive completion
#

log "Event archive complete: $EVENT_DIR"

#
# NTFY notification
#

if [[ "${ENABLE_NTFY,,}" == "true" ]]; then

    log "Sending NTFY notification..."

    #
    # Optional authorization header
    #

    NTFY_HEADERS=()

    if [[ -n "${NTFY_TOKEN:-}" ]]; then
        NTFY_HEADERS+=(
            -H "Authorization: Bearer $NTFY_TOKEN"
        )
    fi

    if curl \
        -s \
        "${NTFY_HEADERS[@]}" \
        -H "Title: Failed Unlock Attempt" \
        -H "Priority: $NTFY_PRIORITY" \
        -d "Failed unlock detected on $(hostname)

Event ID:
$EVENT_ID" \
        "$NTFY_URL"
    then
        log "NTFY notification sent"
    else
        log "ERROR: Failed to send NTFY notification"
    fi

fi

#
# Email notification
#

if [[ "${ENABLE_EMAIL,,}" == "true" ]]; then

    log "Sending email notification..."

    EMAIL_SUBJECT="[screenwarn] Failed unlock on $(hostname)"

    EMAIL_BODY=$(cat <<EOF
Failed unlock detected.

Hostname: $(hostname)
Event ID: $EVENT_ID

See attached GIF preview and MP4 evidence.
EOF
)

    #
    # Build attachment list
    #

    ATTACHMENTS=(-a "$GIF_PATH")

    if [[ "${EMAIL_ATTACH_MP4,,}" == "true" ]]; then
        ATTACHMENTS+=(-a "$MP4_PATH")
    fi

    #
    # Send email with timeout protection
    #

    if echo "$EMAIL_BODY" | \
        timeout 30 mutt \
            -s "$EMAIL_SUBJECT" \
            "${ATTACHMENTS[@]}" \
            -- "$EMAIL_TO"
    then
        log "Email notification sent"
    else
        log "ERROR: Failed to send email notification"
    fi

fi

#
# Cleanup old events
#

log "Running retention cleanup..."

find "$EVENT_ROOT" \
    -mindepth 1 \
    -maxdepth 1 \
    -type d \
    -mtime +"$RETENTION_DAYS" \
    -exec rm -rf {} + \
    2>/dev/null || true

#
# Final completion
#

log "screenwarn event complete: $EVENT_ID"