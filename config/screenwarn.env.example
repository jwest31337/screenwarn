#
# screenwarn configuration
#

CONFIG_VERSION=1

#
# Webcam settings
#

CAMERA_DEVICE="/dev/video0"

CAPTURE_SIZE="1280x720"
CAPTURE_FPS="10"
CAPTURE_SECONDS="2"

STEALTH_DELAY="0.7"

#
# Cooldown
#

COOLDOWN_SECONDS="30"

#
# Retention
#

RETENTION_DAYS="30"

#
# NTFY notifications
#

ENABLE_NTFY="false"

NTFY_URL="https://ntfy.example.com/topic"
NTFY_TOKEN="tk_exampletoken"

NTFY_PRIORITY="urgent"

#
# Email notifications
#

ENABLE_EMAIL="false"

EMAIL_TO="you@example.com"

EMAIL_ATTACH_MP4="false"
